# ==========================================================================
# BELLWOOD CONSTRUCTION LLC — Apache / LiteSpeed config for Hostinger
# ==========================================================================
# This is the Hostinger equivalent of netlify.toml. It is read automatically
# once the files are in public_html. You should not need to edit it.
# ==========================================================================

# --- Default page ---------------------------------------------------------
DirectoryIndex index.html

# --- Force HTTPS ----------------------------------------------------------
# Hostinger issues a free SSL certificate. This sends anyone who types the
# plain http:// address over to the secure one.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# --- Security headers -----------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Caching --------------------------------------------------------------
# Photos and icons never change once published, so browsers keep them for a
# year. Code is re-checked every visit, so edits show up immediately.
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compression ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

# --- Correct types --------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/manifest+json .webmanifest
</IfModule>

# --- Keep internals private -----------------------------------------------
<FilesMatch "^\.(git|gitignore|env)">
  Require all denied
</FilesMatch>
